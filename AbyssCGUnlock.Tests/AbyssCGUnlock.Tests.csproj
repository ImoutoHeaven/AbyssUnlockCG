<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GameDir Condition="'$(GameDir)' == ''">$(ABYSS_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Users\Eden\PixelAbyssX\dotabyss_x_cl</GameDir>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json;https://nuget.samboy.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接链接生产源码（与 AbyssMod.Tests 同风格：测试真实生产代码） -->
    <Compile Include="..\AbyssCGUnlock\**\*.cs" />
    <!-- 排除 obj/bin 生成物，避免与测试工程自身生成的程序集属性冲突 -->
    <Compile Remove="..\AbyssCGUnlock\obj\**" />
    <Compile Remove="..\AbyssCGUnlock\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 编译期需要 BepInEx / Il2CppInterop 与游戏 interop 代理程序集 -->
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Core.dll" Private="true" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="true" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="true" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.HarmonySupport.dll" Private="true" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="true" />
    <Reference Include="$(GameDir)/BepInEx/interop/*.dll" Private="false" />
  </ItemGroup>

</Project>
